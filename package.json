{
  "name": "semlia",
  "version": "0.0.0",
  "private": true,
  "description": "AI-first semantic asset control plane",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
