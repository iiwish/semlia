{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semlia.ask-interpretation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome"],
  "properties": {
    "schema": { "const": "semlia.ask-interpretation/v1" },
    "outcome": { "enum": ["query", "clarification"] },
    "query": { "$ref": "#/$defs/query" },
    "clarification": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "query" } } },
      "then": { "required": ["query"], "not": { "required": ["clarification"] } }
    },
    {
      "if": { "properties": { "outcome": { "const": "clarification" } } },
      "then": { "required": ["clarification"], "not": { "required": ["query"] } }
    }
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string", "pattern": "^ast_[0-9a-z]{26}$" },
        "address": { "type": "string", "minLength": 1, "maxLength": 240 },
        "search": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "oneOf": [
        { "required": ["assetId"] },
        { "required": ["address"] },
        { "required": ["search"] }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "operator", "value"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "contains"] },
        "value": {}
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "from", "to"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "granularity": { "enum": ["day", "week", "month", "quarter", "year"] }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "direction"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "direction": { "enum": ["asc", "desc"] }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "measures", "dimensions", "filters", "order"],
      "properties": {
        "intent": { "enum": ["describe", "aggregate", "breakdown", "compare"] },
        "measures": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/selector" } },
        "dimensions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/selector" } },
        "filters": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/filter" } },
        "timeRange": { "$ref": "#/$defs/timeRange" },
        "order": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/order" } },
        "limit": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
