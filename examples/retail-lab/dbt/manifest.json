      ],
      "alias": "fct_member_activity",
      "checksum": {
        "name": "sha256",
        "checksum": "fct_member_activity"
      },
      "raw_code": "select member_id, min(paid_at) as first_paid_at, max(paid_at) as last_paid_at, count(*) as paid_orders\nfrom {{ ref('stg_valid_orders') }}\nwhere member_id is not null and order_type = 'normal'\ngroup by member_id",
      "depends_on": {
        "nodes": [
          "model.retail_lab.stg_valid_orders"
        ]
      }
    }
