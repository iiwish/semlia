+			case "input digest":
+				g.request.InputDigest = "sha256:" + strings.Repeat("b", 64)
+			case "budget":
+				g.request.MaxCostMicros = 1
+			case "version":
+				g.request.ExpectedVersion = 2
+			case "agent revoked", "caller revoked":
