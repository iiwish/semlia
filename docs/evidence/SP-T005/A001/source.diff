+			for _, field := range []string{"address", "assetType", "ownerPrincipalId"} {
+				x, _ := domain.CanonicalJSON(a[field])
+				y, _ := domain.CanonicalJSON(b[field])
+				if !bytes.Equal(x, y) {
+					return ErrAIOutputInvalid
+				}
+			}
+		}
+	}
