+    await page.getByLabel("适用范围", { exact: true }).fill("Acceptance commerce source; reviewed business scope.");
+  }
+  await page.getByRole("button", { name: "保存纠正版本", exact: true }).click();
+  await expect.poll(async () => (await (await context.request.get(operationPath)).json()).version).toBe(3);
+  const corrected = await (await context.request.get(operationPath)).json();
+  expect(corrected.generationApplications).toHaveLength(1);
+  expect(corrected.targets.filter((target: { declaration: { kind: string } }) => target.declaration.kind === "semantic_asset")).toHaveLength(3);
+  await page.screenshot({ path: `${process.env.SEMLIA_ACCEPTANCE_ROOT}/corrected-${name}.png` });
+  await page.getByRole("button", { name: "冻结并提交验证", exact: true }).click();
+  await expect(page.getByText("验证失败", { exact: true })).toBeVisible();
+  await expect(page.getByText("PRODUCTION_BUSINESS_RULE_UNCONFIRMED", { exact: true }).first()).toBeVisible();
+  await expect(page.getByRole("button", { name: "批准整个集合", exact: true })).toBeDisabled();
+  await confirmRules(page, name);
+  await page.getByRole("tab", { name: "验证与审核", exact: true }).click();
+  await page.getByLabel("审核或重验说明", { exact: true }).fill("Explicit business declarations are complete; revalidate all objects.");
+  await page.getByRole("button", { name: "重新验证", exact: true }).click();
+  await expect(page.getByText("验证通过", { exact: true })).toBeVisible();
+  await approve(page, operationId);
+  await openAs(page, "author", operationId);
+  await page.getByRole("complementary", { name: "生产对象" }).getByRole("button", { name: new RegExp(`^${name} revenue`) }).click();
+  await page.getByLabel("业务定义", { exact: true }).fill("Sum of paid order amounts, excluding cancelled orders and net of refunds.");
+  await page.getByRole("tab", { name: "验证与审核", exact: true }).click();
+  await expect(page.getByText(/有未保存的纠正/)).toBeVisible();
+  await expect(page.getByRole("button", { name: "批准整个集合", exact: true })).toBeDisabled();
+  const predecessorId = operationId;
+  await page.getByRole("button", { name: "保存纠正版本", exact: true }).click();
+  await expect.poll(() => new URL(page.url()).searchParams.get("production")).not.toBe(predecessorId);
+  operationId = new URL(page.url()).searchParams.get("production")!;
+  operationPath = `/api/v1/workspaces/${bootstrap.workspaceId}/production-operations/${operationId}`;
+  const successor = await (await context.request.get(operationPath)).json();
+  expect(successor.version).toBe(1);
+  expect(successor.activeValidation.status).toBe("not_requested");
+  await openAs(page, "publisher", operationId);
+  await page.getByRole("tab", { name: "发布与恢复", exact: true }).click();
+  await expect(page.getByRole("button", { name: "发布整个集合", exact: true })).toBeDisabled();
+  await openAs(page, "author", operationId);
+  await confirmRules(page, name);
+  await page.getByRole("button", { name: "冻结并提交验证", exact: true }).click();
+  await expect(page.getByText("验证通过", { exact: true })).toBeVisible();
+  await page.screenshot({ path: `${process.env.SEMLIA_ACCEPTANCE_ROOT}/validated-${name}.png` });
+  await approve(page, operationId);
+  await openAs(page, "publisher", operationId);
+  await page.getByRole("tab", { name: "发布与恢复", exact: true }).click();
+  await page.getByRole("checkbox", { name: "已核对整个集合及当前验证审核", exact: true }).check();
+  await page.getByRole("button", { name: "发布整个集合", exact: true }).click();
+  await expect(page.getByText("已同步", { exact: true })).toBeVisible();
+  const publishedId = new URL(page.url()).searchParams.get("productionRelease")!;
+  expect(publishedId).toBeTruthy();
+  const releasePath = `/api/v1/workspaces/${bootstrap.workspaceId}/production-releases/`;
+  const published = await (await context.request.get(releasePath + publishedId)).json();
+  expect(published.originProposalIds).toHaveLength(10);
+  expect(published.beforePins).toHaveLength(10);
+  await page.screenshot({ path: `${process.env.SEMLIA_ACCEPTANCE_ROOT}/published-${name}.png` });
+  await page.getByLabel("回滚原因", { exact: true }).fill("Acceptance rollback of the complete ten-object set.");
+  await page.getByRole("button", { name: "创建回滚版本", exact: true }).click();
+  await expect.poll(() => new URL(page.url()).searchParams.get("productionRelease")).not.toBe(publishedId);
+  const rollbackId = new URL(page.url()).searchParams.get("productionRelease")!;
+  await page.evaluate(() => localStorage.clear()); await page.reload();
+  await page.getByRole("tab", { name: "发布与恢复", exact: true }).click();
+  await expect(page.getByText(rollbackId, { exact: true })).toBeVisible();
+  await expect(page.getByText("已同步", { exact: true })).toBeVisible();
+  await page.getByLabel("回滚原因", { exact: true }).fill("Restore the exact immutable published set by rolling back the rollback.");
+  await page.getByRole("button", { name: "创建回滚版本", exact: true }).click();
+  await expect.poll(() => new URL(page.url()).searchParams.get("productionRelease")).not.toBe(rollbackId);
+  await expect(page.getByText("已同步", { exact: true })).toBeVisible();
+  const restoredId = new URL(page.url()).searchParams.get("productionRelease")!;
+  const restored = await (await context.request.get(releasePath + restoredId)).json();
+  expect(restored.afterManifest).toEqual(published.afterManifest);
+  expect(await (await context.request.get(releasePath + publishedId)).json()).toEqual(published);
