+import { test, expect } from "@playwright/test";
+import { writeFileSync } from "node:fs";
+import { addCompositeTargets, approve, bootstrap, confirmRules, login, openAs, sourceSQL } from "./fixtures";
+
+test("isolated identity and server-owned production workspace", async ({ page, context }) => {
+  const failures: string[] = [];
+  page.on("response", (response) => { if (response.url().includes("/api/") && response.status() >= 400) failures.push(`${response.status()} ${response.url()}`); });
+  expect(bootstrap.mode).toBe("protocol_stub");
+  await login(context, "author");
+  await page.goto("/governance?productionList=1");
+  await expect(page.getByRole("region", { name: "语义生产", exact: true })).toBeVisible();
+  const records = await context.request.get(`/api/v1/workspaces/${bootstrap.workspaceId}/production-operations`);
+  expect(records.ok()).toBeTruthy();
+  const operations = await records.json();
+  if (!operations.items.length) await expect(page.getByText("暂无生产记录", { exact: true })).toBeVisible();
+  else await expect(page.getByRole("region", { name: "可恢复的生产记录" })).toBeVisible();
+  await page.waitForLoadState("networkidle");
+  expect(failures).toEqual([]);
+  await page.screenshot({ path: `${process.env.SEMLIA_ACCEPTANCE_ROOT}/empty-${test.info().project.name}.png` });
+});
+
+test("source candidate creates a server-owned semantic draft without seeded assets", async ({ page, context }) => {
+  await login(context, "author");
+  const name = test.info().project.name.replaceAll("-", "_");
+  const path = sourceSQL(name);
+  await page.goto("/sources");
+  await page.getByRole("button", { name: "导入工件", exact: true }).click();
+  const dialog = page.getByRole("dialog", { name: "导入工件" });
+  await dialog.getByLabel("来源名称", { exact: true }).fill(`Acceptance ${name}`);
+  await dialog.getByLabel("工件类型").selectOption("sql_bundle");
+  await dialog.getByLabel("配置根目录内 SQL 路径").fill(path);
+  await dialog.getByRole("button", { name: "校验并保存来源" }).click();
+  await expect(dialog).not.toBeVisible();
+  await page.getByRole("button", { name: "关闭持久工件集合", exact: true }).click();
+  await page.getByRole("button", { name: `启动发现 Acceptance ${name}`, exact: true }).click();
+  await page.getByRole("button", { name: "查看运行", exact: true }).click();
+  await page.getByRole("button", { name: new RegExp(`public.${name}_orders`) }).click();
+  const production = page.getByRole("region", { name: "语义生产", exact: true });
+  await production.getByRole("button", { name: "新建语义资产", exact: true }).click();
+  await expect(production.getByLabel("业务定义", { exact: true })).toHaveValue("");
+  await production.getByLabel("对象名称", { exact: true }).fill(`${name} orders`);
+  await production.getByLabel("资产地址", { exact: true }).fill(`acceptance.${name}_orders`);
+  await production.getByRole("button", { name: "保存生产草稿" }).click();
+  await expect(page).toHaveURL(/production=/);
+  await expect(production.getByText("保存生产草稿已由服务器接收。", { exact: true })).toBeVisible();
+  await page.evaluate(() => localStorage.clear());
+  await page.reload();
+  await expect(page.getByLabel("资产地址", { exact: true })).toHaveValue(`acceptance.${name}_orders`);
+  await page.screenshot({ path: `${process.env.SEMLIA_ACCEPTANCE_ROOT}/draft-${name}.png` });
+  await addCompositeTargets(page, name);
+  await page.getByRole("button", { name: "保存纠正版本", exact: true }).click();
+  await expect(page.getByText("保存纠正版本已由服务器接收。", { exact: true })).toBeVisible();
+  let operationId = new URL(page.url()).searchParams.get("production")!;
+  let operationPath = `/api/v1/workspaces/${bootstrap.workspaceId}/production-operations/${operationId}`;
+  const version2 = await (await context.request.get(operationPath)).json();
+  expect(version2.version).toBe(2);
+  expect(version2.targets).toHaveLength(10);
+  await page.getByLabel("建模要求", { exact: true }).fill("Suggest definitions for the two entities and the paid-order revenue metric. Keep business confirmation unresolved.");
+  await page.getByRole("button", { name: "生成结构化建议", exact: true }).click();
+  await expect(page.getByText("建议已保存", { exact: true })).toBeVisible();
+  await expect(page.getByText(/协议替身 · 合成验收响应/)).toBeVisible();
+  await page.getByRole("button", { name: "应用到编辑区", exact: true }).click();
+  for (const [suffix, definition] of [["orders", "One order per order_id."], ["customers", "One customer per customer_id."], ["revenue", "Sum of paid order amounts, excluding cancelled orders."]]) {
+    await page.getByRole("complementary", { name: "生产对象" }).getByRole("button", { name: new RegExp(`^${name} ${suffix}`) }).click();
+    await expect(page.getByLabel("业务定义", { exact: true })).toHaveValue(/Protocol stub suggestion/);
