+	t.Helper()
+	loader, err := application.NewArtifactLoader("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return application.NewControlService(store, nil, nil, loader, nil, evaluator, application.ClockFunc(time.Now)).WithSnapshotCursorSecret([]byte(strings.Repeat("k", 32)))
+}
