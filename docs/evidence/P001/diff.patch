+      {publishing && <PublishDialog onClose={() => setPublishing(false)} onPublish={publishCandidate} />}
+      {toast && <div className="toast" role="status"><CheckCircle2 size={17} /><span>{toast}</span></div>}
+    </div>
+  );
+}
