+    padding: 7px 10px 9px;
+    display: flex;
+    gap: 6px;
+    overflow-x: auto;
+  }
+
+  .context-item {
+    width: 142px;
+    min-width: 142px;
+    min-height: 46px;
+    grid-template-columns: 7px minmax(0, 1fr);
+    background: #ffffff;
+    border-color: #e2e6ec;
+  }
+
+  .context-item > svg {
+    display: none;
+  }
+
+  .context-item-active::before {
+    display: none;
+  }
+
+  .workspace {
+    order: 1;
+    height: auto;
+    min-height: 0;
+    overflow: visible;
+  }
+
+  .topbar {
+    position: sticky;
+    top: 0;
+    height: 50px;
+    flex-basis: 50px;
+    padding: 0 11px;
+  }
+
+  .workspace-breadcrumb span,
+  .workspace-breadcrumb svg,
+  .release-indicator {
+    display: none;
+  }
+
+  .workspace-canvas {
+    width: 100%;
+    overflow: visible;
+  }
+
+  .view {
+    padding: 20px 12px 28px;
+  }
+
+  .page-heading h1 {
+    font-size: 20px;
+  }
+
+  .topbar .primary-button {
+    width: 34px;
+    min-width: 34px;
+    height: 34px;
+    padding: 0;
+    font-size: 0;
+  }
+
+  .mock-badge {
+    min-height: 26px;
+    padding: 0 7px;
+    font-size: 9px;
+  }
+}
+
+/* Legacy narrow-screen compatibility; not part of the supported product surface. */
+@media (max-width: 720px) {
+  .rail-navigation {
+    grid-template-columns: repeat(6, minmax(0, 1fr));
+    gap: 1px;
+    overflow: hidden;
+  }
+
+  .rail-item {
+    min-width: 0;
+    gap: 2px;
+  }
+
+  .rail-item svg {
+    width: 16px;
+    height: 16px;
+  }
+
+  .rail-label {
+    max-width: 100%;
+    overflow: hidden;
+    font-size: 8px;
+    text-overflow: ellipsis;
+  }
+}
+
+/* Desktop card hierarchy */
+.workspace-canvas {
+  background: #f5f7fa;
+  background-image: none;
+}
+
+.metric-strip,
+.readiness-strip {
+  gap: 12px;
+  background: transparent;
+  border: 0;
+  box-shadow: none;
+}
+
+.metric-strip > div,
+.readiness-strip > div {
+  background: #ffffff;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+}
+
+.metric-strip > div:last-child,
+.readiness-strip > div:last-child {
+  border-right: 1px solid var(--border);
+}
+
+.source-registry,
+.channel-band,
+.binding-registry,
+.feedback-panel {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+.source-registry > .panel-heading,
+.channel-band > .panel-heading,
+.binding-registry > .panel-heading,
+.feedback-panel > .panel-heading {
+  min-height: 48px;
+  padding: 0 2px 10px;
+  border-bottom: 0;
+}
+
+.source-list,
+.binding-list,
+.feedback-events {
+  display: grid;
+  gap: 10px;
+}
+
+.source-list > article,
+.binding-list > article,
+.feedback-events > article {
+  background: #ffffff;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+}
+
+.permission-boundary {
+  margin-top: 10px;
+  border: 1px solid #c7e4da;
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+}
+
+.channel-grid {
+  gap: 10px;
+}
+
+.channel-grid > button {
+  background: #ffffff;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+}
+
+.channel-grid > button:last-child {
+  border-right: 1px solid var(--border);
+}
+
+.feedback-metrics {
+  gap: 10px;
+  border-bottom: 0;
+}
+
+.feedback-metrics > div {
+  background: #ffffff;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+}
+
+.feedback-metrics > div:last-child {
+  border-right: 1px solid var(--border);
+}
+
+.feedback-events {
+  margin-top: 10px;
+}
+
+.feedback-action {
+  margin: 12px 0 0;
+}
