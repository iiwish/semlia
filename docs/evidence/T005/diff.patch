+func TestWorkerRetriesThenDeadLettersWithStableErrorCode(t *testing.T) {
+	pool, store := newStore(t)
+	resetData(t, pool)
+	createWorkspace(t, pool, "workspace_retry")
+	now := time.Date(2026, 8, 10, 8, 0, 0, 0, time.UTC)
