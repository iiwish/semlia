+			WHERE row_to_json(outbox_events)::text LIKE '%publisher-secret%'
+		)`).Scan(&leaked); err != nil {
+		t.Fatal(err)
+	}
+	if leaked {
+		t.Fatal("raw publisher error leaked into outbox persistence")
+	}
+}
