@@ -0,0 +1,39 @@
+import { authorizationRoles, authorizationSession } from "./data";
+import type { CapabilitySession } from "./types";
+
+export type LocalUATActor = "author" | "reviewer" | "publisher";
+
+const storageKey = "semlia.local-uat-actor";
+
+export const localUATEnabled = import.meta.env.VITE_LOCAL_UAT_IDENTITIES === "1";
+
+export function localUATActor(storage: Pick<Storage, "getItem"> | undefined = browserStorage()): LocalUATActor {
+  const actor = storage?.getItem(storageKey);
+  return actor === "reviewer" || actor === "publisher" ? actor : "author";
+}
+
+export function setLocalUATActor(actor: LocalUATActor, storage: Pick<Storage, "setItem"> | undefined = browserStorage()): void {
+  storage?.setItem(storageKey, actor);
+}
+
+export function localUATHeaders(actor: LocalUATActor): Record<string, string> {
+  return { "X-Semlia-Principal": `local-${actor}` };
+}
+
+export function activeRequestHeaders(): Record<string, string> | undefined {
+  return localUATEnabled ? localUATHeaders(localUATActor()) : undefined;
+}
+
+export function localUATSessionFor(actor: LocalUATActor): CapabilitySession {
+  const roleIds = actor === "author" ? ["ROLE-ASSET-OWNER", "ROLE-SOURCE-OPERATOR"] : actor === "reviewer" ? ["ROLE-REVIEWER"] : ["ROLE-PUBLISHER"];
+  return {
+    ...authorizationSession,
+    principalId: `local-${actor}`,
+    version: "local-uat",
+    capabilities: [...new Set([...roleIds.flatMap((roleId) => authorizationRoles.find((role) => role.id === roleId)?.permissions ?? []), ...(actor === "author" ? ["workspace.manage" as const] : [])])],
+  };
+}
+
+function browserStorage(): Storage | undefined {
+  return typeof window === "undefined" ? undefined : window.localStorage;
+}
