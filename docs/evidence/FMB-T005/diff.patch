+		arg.CursorPriorityRank,
+		arg.CursorDueAt,
+		arg.PageLimit,
+	)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []AttentionItem{}
+	for rows.Next() {
+		var i AttentionItem
+		if err := rows.Scan(
+			&i.ID,
+			&i.WorkspaceID,
+			&i.Kind,
+			&i.DedupeKey,
+			&i.State,
+			&i.Priority,
