+const listReviewedAttentionItemIDs = `-- name: ListReviewedAttentionItemIDs :many
+SELECT DISTINCT item.id
+FROM attention_items AS item
+JOIN proposals AS proposal
+  ON proposal.workspace_id = item.workspace_id
+ AND item.dedupe_key = 'review:' || proposal.id::text
+JOIN reviews AS review
+  ON review.workspace_id = proposal.workspace_id
+ AND review.proposal_id = proposal.id
+WHERE item.workspace_id = $1
+  AND item.id = ANY($2::uuid[])
+  AND review.reviewer_principal_id = $3
+`
+
+type ListReviewedAttentionItemIDsParams struct {
+	WorkspaceID pgtype.UUID   `json:"workspace_id"`
+	ItemIds     []pgtype.UUID `json:"item_ids"`
+	PrincipalID pgtype.UUID   `json:"principal_id"`
+}
