+    expect(localUATEnabled).toBe(false);expect(activeRequestHeaders()).toBeUndefined();
+  });
+  it("maps author, reviewer, and publisher to explicit wire identities and capabilities", () => {
+    expect(localUATHeaders("author")).toEqual({ "X-Semlia-Principal": "local-author" });
+    expect(localUATHeaders("reviewer")).toEqual({ "X-Semlia-Principal": "local-reviewer" });
+    expect(localUATHeaders("publisher")).toEqual({ "X-Semlia-Principal": "local-publisher" });
