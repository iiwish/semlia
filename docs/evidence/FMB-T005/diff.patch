+    expect(localUATSessionFor("author").capabilities).not.toContain("release.publish");
+    expect(localUATSessionFor("reviewer").capabilities).toContain("proposal.review");
+    expect(localUATSessionFor("reviewer").capabilities).not.toContain("release.publish");
+    expect(localUATSessionFor("publisher").capabilities).toContain("release.publish");
+    expect(localUATSessionFor("publisher").capabilities).not.toContain("proposal.review");
+  });
