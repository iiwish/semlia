+func (report *cleanupReport) setDockerProblem(label string, err error) {
+	if report.dockerProblems == nil {
+		report.dockerProblems = make(map[string]error)
+	}
+	if err == nil {
+		delete(report.dockerProblems, label)
+	} else {
