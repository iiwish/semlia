+		fmt.Printf("LOCK_PATH=%s\n", acceptanceHostLock)
+		return
+	}
+
+	var paths []string
+	for _, temporaryDirectory := range []string{t.TempDir(), t.TempDir()} {
+		command := exec.Command(os.Args[0], "-test.run=^TestAcceptanceHostLockPathIgnoresTMPDIR$", "-test.count=1")
