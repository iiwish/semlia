+	}
+	if err := validateGoToolchainOutput(stdout.String(), stderr.String(), runtime.GOOS, runtime.GOARCH); err != nil {
+		return fmt.Errorf("validate isolated Go toolchain: %w", err)
+	}
+	return nil
