+	script := "#!/bin/bash\n" +
+		"printf '%s\\n' \"$$\" >'" + parentRecord + "'\n" +
+		"printf '%s\\n' 'hanging node parent'\n" +
+		"/bin/bash -c 'trap \"\" TERM; printf \"%s\\\\n\" \"$$\" >\"$1\"; printf \"%s\\\\n\" \"hanging node descendant\" >&2; /bin/sleep 300' child '" + descendantRecord + "' &\n" +
+		"trap '' TERM\n" +
