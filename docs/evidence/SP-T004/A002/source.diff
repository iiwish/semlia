+		payload["targets"] = append(payload["targets"].([]any), map[string]any{"localKey": kind, "intent": "create", "kind": kind, "identityKey": "fixture." + kind, "title": kind, "content": contents[kind], "changes": []any{}, "evidenceIds": []any{}})
+	}
