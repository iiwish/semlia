+	ByteSize      int64
+	MediaType     string
+	StorageKey    string
+	CreatedAt     time.Time
+}
+
+type CleanupObject struct {
+	WorkspaceID   identity.WorkspaceID
+	ContentDigest string
+	ByteSize      int64
+}
+
+type ArtifactSet struct {
+	ID                   identity.ArtifactSetID
+	WorkspaceID          identity.WorkspaceID
+	SourceConnectionID   identity.SourceConnectionID
