+
+  return <div className="dialog-backdrop" role="presentation" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}><section className="review-dialog candidate-convert-dialog" role="dialog" aria-modal="true" aria-labelledby="candidate-live-title"><header><div><span className="panel-kicker">语义候选 · {candidate.id}</span><h2 id="candidate-live-title">{candidate.title}</h2></div><button className="icon-button" type="button" aria-label="关闭候选详情" onClick={onClose}><X size={18} /></button></header><div className="dialog-body"><div className="candidate-evidence-strip"><span><small>来源 revision</small><code>{candidate.sourceRevisionId}</code></span><span><small>发现运行</small><code>{candidate.discoveryRunId}</code></span><span><small>内容摘要</small><code>{shortId(candidate.contentDigest)}</code></span></div><details className="candidate-raw-evidence"><summary>查看不可变发现证据</summary><pre>{JSON.stringify({ proposalInput: candidate.proposalInput, evidence: candidate.evidence }, null, 2)}</pre></details>{candidate.status === "pending" ? <div className="candidate-convert-form"><label><span>目标语义资产</span><select aria-label="目标语义资产" value={assetId} onChange={(event) => { const nextId = event.target.value; setAssetId(nextId); const next = assets.find((asset) => asset.id === nextId); setDefinition(next ? candidateDefinition(next.definition, candidate) : ""); }}><option value="">选择现有资产</option>{assets.map((asset) => <option value={asset.id} key={asset.id}>{asset.name} · {asset.identity.namespace}.{asset.key}</option>)}</select></label><label><span>候选定义</span><textarea aria-label="候选定义" value={definition} onChange={(event) => setDefinition(event.target.value)} /></label><label><span>决策依据</span><textarea aria-label="候选决策依据" value={reason} onChange={(event) => setReason(event.target.value)} /></label>{assets.length === 0 && <div className="source-form-error"><AlertTriangle size={15} />当前工作区没有可作为治理目标的语义资产。</div>}{error && <div className="source-form-error" role="alert"><CircleAlert size={15} />{error}</div>}</div> : <div className="source-secret-boundary"><CheckCircle2 size={18} /><span><strong>{candidateLabels[candidate.status]}</strong><small>{candidate.proposalId ? `治理提案 ${candidate.proposalId}` : "候选决策已保存"}</small></span></div>}</div><footer>{candidate.status === "pending" ? <><button className="secondary-button" type="button" disabled={busy || !reason.trim()} onClick={() => void dismiss()}>忽略候选</button><span /><div><button className="secondary-button" type="button" onClick={onClose}>取消</button><button className="primary-button" type="button" disabled={!canPropose || !target || !definition.trim() || definition.trim() === target?.definition.trim() || !reason.trim() || busy} onClick={() => void convert()}>{busy ? <LoaderCircle className="is-spinning" size={15} /> : <GitPullRequestArrow size={15} />}{preparedProposalId ? "重试关联提案" : "创建并打开提案"}</button></div></> : <><span /><div><button className="secondary-button" type="button" onClick={onClose}>关闭</button>{candidate.proposalId && <button className="primary-button" type="button" onClick={() => onOpenProposal(candidate.proposalId!)}><GitPullRequestArrow size={15} />打开提案</button>}</div></>}</footer></section></div>;
