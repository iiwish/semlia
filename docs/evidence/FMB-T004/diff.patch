+
+function CandidateDialog({ candidate, assets, workspaceId, canPropose, createAndSubmitProposal, onClose, onUpdated, onOpenProposal }: { candidate: SemanticCandidate; assets: ReturnType<typeof useCatalogRuntime>["assets"]; workspaceId: string; canPropose: boolean; createAndSubmitProposal: ReturnType<typeof useGovernanceRuntime>["createAndSubmitProposal"]; onClose: () => void; onUpdated: (candidate: SemanticCandidate) => void; onOpenProposal: (proposalId: string) => void }) {
