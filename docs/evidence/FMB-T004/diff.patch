+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ListAccountMembershipsRow{}
+	for rows.Next() {
+		var i ListAccountMembershipsRow
+		if err := rows.Scan(
+			&i.ID,
+			&i.WorkspaceID,
+			&i.UserAccountID,
+			&i.PrincipalID,
+			&i.Status,
+			&i.AdmittedByPrincipalID,
+			&i.AdmittedAt,
+			&i.SuspendedAt,
+			&i.RevokedAt,
+			&i.CreatedAt,
+			&i.UpdatedAt,
+			&i.PrincipalDisplayName,
+			&i.WorkspaceSlug,
+			&i.WorkspaceDisplayName,
+			&i.AuthorizationVersion,
+			&i.RoleIds,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
