+	if errors.Is(err, pgx.ErrNoRows) {
+		return domain.Artifact{}, domain.ErrNotFound
+	}
+	if err != nil {
+		return domain.Artifact{}, artifactRepositoryError("get artifact", err)
+	}
+	return value, nil
+}
