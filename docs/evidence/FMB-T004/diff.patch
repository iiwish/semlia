+               WHEN (payload->>'right_dataset_id')::uuid IN (SELECT dataset_id FROM asset_datasets)
+                 THEN COALESCE(payload->>'left_dataset_id', '')
+               ELSE ''
+           END,
+           jsonb_build_object(
