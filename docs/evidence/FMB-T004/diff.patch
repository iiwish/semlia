+function CandidateList({ candidates, sourceName, onOpen, onOpenProposal }: { candidates: SemanticCandidate[]; sourceName: (id: string) => string; onOpen: (candidate: SemanticCandidate) => void; onOpenProposal: (proposalId: string) => void }) {
