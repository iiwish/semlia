+const listAttentionItems = `-- name: ListAttentionItems :many
+SELECT item.id, item.workspace_id, item.kind, item.dedupe_key, item.state, item.priority,
+       item.risk, item.target_type, item.target_id, item.target_route, item.assignee_principal_id,
+       item.audience_role_id, item.initiator_principal_id, item.rule_version, item.title,
+       item.summary, item.reason_code, item.evidence_ref, item.trace_id, item.opened_at,
+       item.due_at, item.resolved_at, item.updated_at, item.version
+FROM attention_items AS item
+WHERE item.workspace_id = $1
+  AND item.kind = ANY($2::text[])
+  AND ($3::text = '' OR item.kind = $3::text)
+  AND ($4::text = '' OR item.state = $4::text)
+  AND ($5::text = '' OR item.priority = $5::text)
+  AND ($6::text = '' OR item.risk = $6::text)
+  AND ($7::text = '' OR item.title ILIKE '%' || $7::text || '%'
+       OR item.summary ILIKE '%' || $7::text || '%'
+       OR item.target_id ILIKE '%' || $7::text || '%')
+  AND EXISTS (
+      SELECT 1
+      FROM jsonb_to_recordset($8::jsonb)
+          AS access("action" text, "scopeType" text, "scopeId" text)
+      WHERE access."action" = CASE item.kind
+              WHEN 'review' THEN 'asset.read'
+              WHEN 'validation' THEN 'asset.read'
+              WHEN 'source' THEN 'source.read'
+              WHEN 'runtime' THEN 'runtime.read'
+              WHEN 'compatibility' THEN 'binding.read'
+          END
+		AND (access."scopeType" = '*'
+		     OR (access."scopeType" = item.target_type AND access."scopeId" = item.target_id))
+  )
+  AND (
+      ($9::text = 'initiated' AND item.initiator_principal_id = $10)
+      OR ($9::text = 'mine' AND (
+          item.assignee_principal_id = $10
+          OR (item.assignee_principal_id IS NULL AND item.audience_role_id IS NOT NULL AND EXISTS (
+              SELECT 1
+              FROM jsonb_to_recordset($8::jsonb)
+                  AS audience("roleId" text, "scopeType" text, "scopeId" text)
+              WHERE audience."roleId" = item.audience_role_id
+				AND (audience."scopeType" = '*'
+                     OR (audience."scopeType" = item.target_type AND audience."scopeId" = item.target_id))
+          ))
+      ))
+      OR ($9::text = 'team' AND item.assignee_principal_id IS NULL AND (
+          item.audience_role_id IS NULL OR EXISTS (
+              SELECT 1
+              FROM jsonb_to_recordset($8::jsonb)
+                  AS audience("roleId" text, "scopeType" text, "scopeId" text)
+              WHERE audience."roleId" = item.audience_role_id
+				AND (audience."scopeType" = '*'
+                     OR (audience."scopeType" = item.target_type AND audience."scopeId" = item.target_id))
+          )
+      ))
+  )
+  AND (
+      NOT $11::boolean
+      OR ($12::text = 'updated_desc' AND (item.updated_at, item.id) < ($13, $14::uuid))
+      OR ($12::text = 'priority_desc' AND (
+          CASE item.priority WHEN 'critical' THEN 4 WHEN 'high' THEN 3 WHEN 'medium' THEN 2 ELSE 1 END < $15::integer
+          OR (CASE item.priority WHEN 'critical' THEN 4 WHEN 'high' THEN 3 WHEN 'medium' THEN 2 ELSE 1 END = $15::integer
+              AND (item.updated_at, item.id) < ($13, $14::uuid))
+      ))
+      OR ($12::text = 'due_asc' AND (
+          COALESCE(item.due_at, 'infinity'::timestamptz) > COALESCE($16::timestamptz, 'infinity'::timestamptz)
+          OR (COALESCE(item.due_at, 'infinity'::timestamptz) = COALESCE($16::timestamptz, 'infinity'::timestamptz)
+              AND (item.updated_at, item.id) < ($13, $14::uuid))
+      ))
+  )
+ORDER BY
+  CASE WHEN $12::text = 'priority_desc' THEN
+      CASE item.priority WHEN 'critical' THEN 4 WHEN 'high' THEN 3 WHEN 'medium' THEN 2 ELSE 1 END
+  END DESC,
+  CASE WHEN $12::text = 'due_asc' THEN COALESCE(item.due_at, 'infinity'::timestamptz) END ASC,
+  item.updated_at DESC,
+  item.id DESC
+LIMIT $17
+`
+
+type ListAttentionItemsParams struct {
+	WorkspaceID        pgtype.UUID        `json:"workspace_id"`
+	AllowedKinds       []string           `json:"allowed_kinds"`
+	Kind               string             `json:"kind"`
+	State              string             `json:"state"`
+	Priority           string             `json:"priority"`
+	Risk               string             `json:"risk"`
+	Search             string             `json:"search"`
+	AccessGrants       []byte             `json:"access_grants"`
+	View               string             `json:"view"`
+	PrincipalID        pgtype.UUID        `json:"principal_id"`
+	HasCursor          bool               `json:"has_cursor"`
+	Sort               string             `json:"sort"`
+	CursorUpdatedAt    pgtype.Timestamptz `json:"cursor_updated_at"`
+	CursorID           pgtype.UUID        `json:"cursor_id"`
+	CursorPriorityRank int32              `json:"cursor_priority_rank"`
+	CursorDueAt        pgtype.Timestamptz `json:"cursor_due_at"`
+	PageLimit          int32              `json:"page_limit"`
+}
+
+func (q *Queries) ListAttentionItems(ctx context.Context, arg ListAttentionItemsParams) ([]AttentionItem, error) {
+	rows, err := q.db.Query(ctx, listAttentionItems,
+		arg.WorkspaceID,
+		arg.AllowedKinds,
+		arg.Kind,
+		arg.State,
+		arg.Priority,
+		arg.Risk,
+		arg.Search,
+		arg.AccessGrants,
+		arg.View,
+		arg.PrincipalID,
+		arg.HasCursor,
+		arg.Sort,
+		arg.CursorUpdatedAt,
+		arg.CursorID,
+		arg.CursorPriorityRank,
+		arg.CursorDueAt,
+		arg.PageLimit,
+	)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []AttentionItem{}
+	for rows.Next() {
+		var i AttentionItem
+		if err := rows.Scan(
+			&i.ID,
+			&i.WorkspaceID,
+			&i.Kind,
+			&i.DedupeKey,
+			&i.State,
+			&i.Priority,
+			&i.Risk,
+			&i.TargetType,
+			&i.TargetID,
+			&i.TargetRoute,
+			&i.AssigneePrincipalID,
+			&i.AudienceRoleID,
+			&i.InitiatorPrincipalID,
+			&i.RuleVersion,
+			&i.Title,
+			&i.Summary,
+			&i.ReasonCode,
+			&i.EvidenceRef,
+			&i.TraceID,
+			&i.OpenedAt,
+			&i.DueAt,
+			&i.ResolvedAt,
+			&i.UpdatedAt,
+			&i.Version,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
