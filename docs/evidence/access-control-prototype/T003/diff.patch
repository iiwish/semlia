+export function AccessControlView({ onNotify }: { onNotify: (message: string) => void }) {
+  const [activeTab, setActiveTab] = useState<AccessControlTab>("roles");
+  const [roles, setRoles] = useState<AuthorizationRole[]>(authorizationRoles);
