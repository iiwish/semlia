+          <div className="assignment-capability-diff"><CheckCircle2 size={17} /><span><strong>新增 {role.permissions.length} 项操作权限</strong><small>{role.permissions.slice(0, 5).join(" · ")}{role.permissions.length > 5 ? " …" : ""}</small></span></div>
