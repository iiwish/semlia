                "filterRef": {
                  "assetId": "example.term.valid_order",
                  "revisionId": "example-r1"
                },
                "timeAttributeRef": {
                  "assetId": "example.object.order",
                  "revisionId": "example-r1",
                  "memberId": "paid_at"
                },
                "unit": "order",
