    {
      "letter": "B",
      "title": "指标的定义结构与计算层次",
      "subtitle": "同一个指标体系内，明确区分输入属性、基础聚合与聚合后的计算。",
      "takeaway": "跨组汇总客单价必须重新计算分子分母，不能累加或直接平均比率。",
      "calculationLevels": [
        {
          "label": "输入属性",
          "title": "订单实付金额",
          "detail": "一笔订单的数值，保留币种与空值语义。"
        },
        {
          "label": "基础指标",
          "title": "实付总金额 / 有效订单数",
          "detail": "SUM 金额、COUNT DISTINCT 订单键，采用同一范围。"
        },
        {
          "label": "派生指标",
          "title": "客单价 = 总金额 ÷ 订单数",
          "detail": "先聚合再相除；分母为零返回空值，跨组重新计算。"
        }
      ],
      "types": [
        {
          "number": "03",
          "name": "指标",
          "type": "metric",
          "definition": "有业务定义的数值计算，包含基础和派生两种结构。",
          "fields": [
            [
              "计算类型",
              "基础聚合，或引用指标的派生计算"
            ],
            [
              "输入与规则",
              "属性 / 指标引用，聚合 / 公式"
            ],
            [
              "统计范围",
              "口径、时间、筛选条件及粒度"
            ],
            [
              "数值语义",
              "单位、空值、精度与零分母"
            ],
            [
              "汇总约束",
              "依赖无环，同范围，按可加性重算"
            ]
          ],
          "example": "实付总金额与订单数是基础指标，客单价是派生指标。",
          "note": "公式不复制到分析模型或业务口径中。普通客单价不永久绑定老客户条件，本次查询对两个基础指标施加同样条件。以下两个基础指标和一个派生指标都是同一主要类型；它们引用的订单对象、有效订单口径和实现仍是未解析的示例依赖。",
          "sample": {
            "id": "example.metric.avg_order_value",
            "type": "metric",
            "name": "客单价",
            "definition": "同一范围内每笔有效订单的平均实付金额。",
            "scope": "以订单数为分母的说明性定义，企业实际口径待确认。",
            "spec": {
              "kind": "derived",
              "expression": {
                "op": "divide",
                "left": {
                  "metricRef": {
                    "assetId": "example.metric.total_paid_amount",
                    "revisionId": "example-r1"
                  }
                },
                "right": {
                  "metricRef": {
                    "assetId": "example.metric.valid_order_count",
                    "revisionId": "example-r1"
                  }
                }
              },
              "filterConsistency": "same_scope_for_all_inputs",
              "fixedCustomerPredicateRef": null,
              "timeAttributeRef": {
                "assetId": "example.object.order",
                "revisionId": "example-r1",
                "memberId": "paid_at"
              },
              "zeroDenominator": "null",
              "unit": "CNY/order（示例）",
              "rollup": "recompute_from_inputs"
            }
          },
          "relatedSamples": [
            {
              "id": "example.metric.total_paid_amount",
              "type": "metric",
              "name": "实付总金额",
              "definition": "同一有效订单范围内的实付金额之和。",
              "scope": "一行一笔订单、同币种、没有连接扇出的示例范围。",
              "spec": {
                "kind": "aggregate",
                "input": {
                  "attributeRef": {
                    "assetId": "example.object.order",
                    "revisionId": "example-r1",
                    "memberId": "paid_amount"
                  }
