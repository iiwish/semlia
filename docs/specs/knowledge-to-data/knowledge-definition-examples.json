                "aggregation": "sum",
                "filterRef": {
                  "assetId": "example.term.valid_order",
                  "revisionId": "example-r1"
                },
                "timeAttributeRef": {
                  "assetId": "example.object.order",
                  "revisionId": "example-r1",
                  "memberId": "paid_at"
                },
                "unit": "CNY（示例）",
                "nullPolicy": "require_non_null_before_execution",
                "additivity": "disjoint_orders_same_currency"
              }
            },
            {
              "id": "example.metric.valid_order_count",
              "type": "metric",
              "name": "有效订单数",
              "definition": "同一范围内有效订单身份的去重计数。",
              "scope": "统一订单键及有效订单口径兼容的场景。",
              "spec": {
                "kind": "aggregate",
                "input": {
                  "attributeRef": {
                    "assetId": "example.object.order",
                    "revisionId": "example-r1",
                    "memberId": "order_id"
