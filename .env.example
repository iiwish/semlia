# Documentation template only. `make dev` generates usable random credentials in
# the ignored `.semlia/dev.env` file; do not put shared or production secrets here.
COMPOSE_PROJECT_NAME=semlia-local
SEMLIA_HTTP_PORT=8080
SEMLIA_POSTGRES_PORT=5433
SEMLIA_BUILD_VERSION=local
SEMLIA_POSTGRES_PASSWORD=
SEMLIA_SECRET_KEY=
SEMLIA_SOURCE_ARTIFACT_ROOT=
SEMLIA_ARTIFACT_STORE=local
SEMLIA_ARTIFACT_ROOT=
SEMLIA_ARTIFACT_S3_BUCKET=
SEMLIA_ARTIFACT_S3_REGION=
SEMLIA_ARTIFACT_S3_ENDPOINT=
SEMLIA_ARTIFACT_SPOOL_DIR=
SEMLIA_ARTIFACT_RETENTION=720h
# Separate execution-only source references; never reuse discovery credentials.
SEMLIA_EXECUTION_SOURCES=[]
SEMLIA_EXECUTION_ALLOW_PLAINTEXT=false
# Populate a named SEMLIA_EXECUTION_DSN_* secret only in a protected environment.
# Compose requires an explicit environment override for each named DSN.
# Feature fence for semantic production writing; default-off.
SEMLIA_SEMANTIC_PRODUCTION_ENABLED=false
# Empty disables paid production generation. Operator-authored JSON grants pin
# workspaceId, principalId, modelSettingId and modelConfigRevision, and require
# pricingBasis, maxInputBytes, maxOutputTokens, maxCostMicros,
# inputMicrosPerByte and outputMicrosPerToken. Rates must be conservative
# provider-specific upper bounds including message overhead; never token usage
# disguised as actual cost. No credentials belong in these grants.
SEMLIA_PRODUCTION_GENERATION_GRANTS=[]
